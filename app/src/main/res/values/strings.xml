    <string name="privacy_title">Privacy &amp; permissions</string>

    <string name="privacy_open">Why we need access</string>
    <string name="privacy_body">SwimWeek shows your weekly swimming distance from Health Connect. Swim totals stay on this phone. Optional live pool occupancy uses CrowdMonitor (same feed as Stadt Zürich Bäder pages); no swim data is uploaded.</string>
    <string name="privacy_permissions_list">We request read access to:\n• Exercise sessions (to find pool and open-water swims)\n• Distance (to total meters for those sessions)\n• Background read (optional, for the home-screen widget)\n\nWe never write workouts and do not request health history beyond the platform default window.</string>
    <string name="privacy_no_network">INTERNET is used only for optional live pool occupancy (CrowdMonitor). Derived weekly swim totals are stored only on device and excluded from backup.</string>

